{
  "name": "@inkline/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "pnpm run build && pnpm run check && pnpm run test && pnpm --filter @inkline/components test:recipes && pnpm --filter @inkline/components test:targets && pnpm --filter @inkline/components api:check",
    "check": "vp check",
    "typecheck": "pnpm run build && vp check --no-fmt --no-lint",
    "validate": "vp validate",
    "test": "vp run -r test",
    "clean": "pnpm -r exec rm -rf dist",
    "build": "vp run -r build",
    "dev": "vp run website#dev",
    "prepare": "vp config",
    "ci:version": "changeset version",
    "ci:prepublish": "pnpm run build",
    "ci:publish": "pnpm run ci:prepublish && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@uxfront/typescript-config": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
