{
  "name": "@inkline/astro",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./headless": {
      "types": "./dist/headless.d.mts",
      "default": "./dist/headless.mjs"
    },
    "./css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && vp pack",
    "validate": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@styleframe/runtime": "catalog:"
  },
  "devDependencies": {
    "@inkline/components": "workspace:*",
    "@styleframe/cli": "catalog:",
    "@styleframe/core": "catalog:",
    "@styleframe/license": "catalog:",
    "@styleframe/loader": "catalog:",
    "@styleframe/plugin": "catalog:",
    "@styleframe/theme": "catalog:",
    "@styleframe/transpiler": "catalog:",
    "@types/node": "catalog:",
    "astro": "catalog:",
    "jsdom": "catalog:",
    "styleframe": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7"
  },
  "prepublishOnly": "vp run build"
}
