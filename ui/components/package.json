{
  "name": "@inkline/components",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/styleframe-types.ts && unframework build && node scripts/barrels.ts",
    "api:check": "node scripts/api-report.ts check",
    "api:update": "node scripts/api-report.ts update",
    "dev": "unframework preview",
    "preview:build": "unframework preview build --out preview",
    "preview:build:react": "unframework preview build --target react --out preview-react",
    "preview:build:vue": "unframework preview build --target vue --out preview-vue",
    "preview:build:svelte": "unframework preview build --target svelte --out preview-svelte",
    "preview:build:solid": "unframework preview build --target solid --out preview-solid",
    "preview:build:angular": "unframework preview build --target angular --out preview-angular",
    "preview:build:qwik": "unframework preview build --target qwik --out preview-qwik",
    "preview:build:astro": "unframework preview build --target astro --out preview-astro",
    "test:recipes": "node --test scripts/recipes.test.ts scripts/barrels.test.ts scripts/styleframe-types.test.ts scripts/api-report.test.ts",
    "test:targets": "unframework test",
    "visual": "unframework visual"
  },
  "dependencies": {
    "@styleframe/runtime": "catalog:"
  },
  "devDependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-server": "catalog:",
    "@babel/core": "catalog:",
    "@inkline/theme": "workspace:*",
    "@qwik.dev/core": "catalog:",
    "@styleframe/cli": "catalog:",
    "@styleframe/core": "catalog:",
    "@styleframe/license": "catalog:",
    "@styleframe/loader": "catalog:",
    "@styleframe/plugin": "catalog:",
    "@styleframe/theme": "catalog:",
    "@styleframe/transpiler": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/react": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@unframework.dev/testing": "catalog:",
    "@unframework.dev/visual": "catalog:",
    "@uxfront/unframework": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "astro": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rxjs": "catalog:",
    "solid-js": "catalog:",
    "styleframe": "catalog:",
    "svelte": "catalog:",
    "vite": "catalog:unframework",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:unframework",
    "vue": "catalog:"
  }
}
