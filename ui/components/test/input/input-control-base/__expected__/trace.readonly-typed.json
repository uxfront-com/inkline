{
  "version": 1,
  "steps": [
    {
      "action": "type getByRole('textbox', { name: 'Name' }) \"x\"",
      "dom": [
        "<div>",
        "  <label>",
        "    \"Name\"",
        "    <input class=\"input-field\" id=\"name\" name=\"name\" placeholder=\"Your name\" readonly=\"\" type=\"text\" uf:focused=\"\" uf:value=\"Ada\">",
        "  </label>",
        "  <input class=\"input-field\" placeholder=\"Email\" type=\"email\" uf:value=\"\">",
        "  <output>",
        "    \"Ada\"",
        "  </output>",
        "</div>"
      ],
      "aria": [
        "- text: Name",
        "- textbox \"Name\":",
        "  - /placeholder: Your name",
        "  - text: Ada",
        "- textbox \"Email\"",
        "- status: Ada"
      ],
      "events": {}
    }
  ]
}
