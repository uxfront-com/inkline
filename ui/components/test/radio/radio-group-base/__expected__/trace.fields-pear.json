{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('radio', { name: 'Pear' })",
      "dom": [
        "<div>",
        "  <div aria-label=\"Fruit\" id=\"fruit\" role=\"radiogroup\">",
        "    <label>",
        "      <input name=\"fruit\" type=\"radio\" uf:checked=\"false\" value=\"apple\">",
        "      \"Apple\"",
        "    </label>",
        "    <label>",
        "      <input name=\"fruit\" type=\"radio\" uf:checked=\"true\" uf:focused=\"\" value=\"pear\">",
        "      \"Pear\"",
        "    </label>",
        "    <label>",
        "      <input name=\"fruit\" type=\"radio\" uf:checked=\"false\" value=\"fig\">",
        "      \"Fig\"",
        "    </label>",
        "  </div>",
        "  <output>",
        "    \"pear\"",
        "  </output>",
        "</div>"
      ],
      "aria": [
        "- radiogroup \"Fruit\":",
        "  - radio \"Apple\"",
        "  - text: Apple",
        "  - radio \"Pear\" [checked]",
        "  - text: Pear",
        "  - radio \"Fig\"",
        "  - text: Fig",
        "- status: pear"
      ],
      "events": {
        "change": [
          [
            "pear"
          ]
        ]
      }
    }
  ]
}
