{
  "description": "The headless checkbox control, its `checked` model bound by a parent, in each state.",
  "ssr": {
    "unchecked": {
      "props": {}
    },
    "checked": {
      "props": {
        "initial": true
      }
    },
    "readonly": {
      "props": {
        "initial": true,
        "readonly": true
      }
    },
    "disabled": {
      "props": {
        "disabled": true,
        "required": true
      }
    },
    "indeterminate": {
      "props": {
        "indeterminate": true
      }
    },
    "attributes": {
      "props": {
        "attributes": true
      }
    },
    "parent": {
      "props": {
        "parent": true
      }
    }
  }
}
