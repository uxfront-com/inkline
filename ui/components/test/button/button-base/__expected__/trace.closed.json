{
  "version": 1,
  "steps": [
    {
      "action": "click getByRole('button', { name: 'Close' })",
      "dom": [
        "<div>",
        "  <button aria-busy=\"false\" aria-describedby=\"save-hint\" id=\"save\" type=\"button\">",
        "    \"Save\"",
        "  </button>",
        "  <button aria-busy=\"false\" aria-label=\"Close\" type=\"button\" uf:focused=\"\">",
        "    <span aria-hidden=\"true\">",
        "      \"×\"",
        "    </span>",
        "  </button>",
        "  <p id=\"save-hint\">",
        "    \"Saves the draft.\"",
        "  </p>",
        "</div>"
      ],
      "aria": [
        "- button \"Save\"",
        "- button \"Close\"",
        "- paragraph: Saves the draft."
      ],
      "events": {
        "click": [
          [
            "close"
          ]
        ]
      }
    }
  ]
}
